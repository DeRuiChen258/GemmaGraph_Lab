# Local Gemma 4; no cloud API or key is required.
MODEL_PROVIDER=llama_cpp_local
MODEL_ID=gemma-4-E4B-QAT-Q4
MODEL_PATH=/path/to/gemma-4-E4B_q4_0-it.gguf
LLAMA_CPP_DIR=.runtime/llama.cpp
MODEL_GPU_LAYERS=999
MODEL_THREADS=8
MODEL_REVISION=
MODEL_TIMEOUT_SECONDS=600
MODEL_CONTEXT_WINDOW=16384
MODEL_MAX_OUTPUT_TOKENS=2048
DATA_DIR=.data
SANDBOX_IMAGE=gemmagraph-sandbox:0.1
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
API_HOST=127.0.0.1
API_PORT=8010
